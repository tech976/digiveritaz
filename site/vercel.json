{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "digiveritaz.com"
        }
      ],
      "destination": "https://www.digiveritaz.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog-:slug/",
      "destination": "/blog/:slug/",
      "permanent": true
    },
    {
      "source": "/case-study-:slug/",
      "destination": "/case-study/:slug/",
      "permanent": true
    },
    {
      "source": "/casestudy/:slug/",
      "destination": "/case-study/:slug/",
      "permanent": true
    },
    {
      "source": "/our-formula-for-foolproof-performance-marketing-wins/",
      "destination": "/blog/our-formula-for-foolproof-performance-marketing-wins/",
      "permanent": true
    },
    {
      "source": "/top-12-advantages-of-search-engine-marketing/",
      "destination": "/blog/top-12-advantages-of-search-engine-marketing/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-build-strong-digital-presence-for-your-brand/",
      "destination": "/blog/how-to-build-a-strong-digital-presence-for-your-brand/",
      "permanent": true
    }
  ],
  "functions": {
    "api/chat.py": {
      "maxDuration": 10,
      "includeFiles": "api/kb_index.json"
    },
    "api/otp.py": {
      "maxDuration": 10
    }
  }
}
