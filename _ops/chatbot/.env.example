# Copy to repo-root .env (git-ignored) for local dev, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# Fallback chain: GROQ_API_KEY -> GROQ_API_KEY_2 -> GEMINI_API_KEY

GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY_2=your_second_groq_key_here   # optional second key for fallback
GEMINI_API_KEY=your_gemini_key_here        # optional final fallback

GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# Where qualified leads are sent (reuse the contact form's Apps Script / Sheet)
LEAD_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Next-action CTAs surfaced by the bot
WHATSAPP_NUMBER=919956655662
BOOKING_URL=/contact-us/

# ---- MSG91 phone OTP (POST /api/otp) ----
# WhatsApp vs SMS is chosen on the OTP TEMPLATE in the MSG91 dashboard
# (Advanced settings -> primary channel). For WhatsApp OTP, use a Meta-approved
# WhatsApp Authentication template and set its channel to WhatsApp.
MSG91_AUTHKEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_whatsapp_otp_template_id_here
MSG91_OTP_EXPIRY=5          # minutes (optional)
MSG91_OTP_LENGTH=6          # digits (optional)
MSG91_COUNTRY=91            # default country code (optional)

# Dev/test the OTP UX WITHOUT MSG91 (no real message sent). Remove/disable in prod.
OTP_DEV_MODE=1             # "1" = test mode; verify accepts OTP_DEV_CODE
OTP_DEV_CODE=123456
