# Copy to repo-root .env (git-ignored) for local dev, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# Fallback chain: GROQ_API_KEY -> GROQ_API_KEY_2 -> GEMINI_API_KEY

GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY_2=your_second_groq_key_here   # optional second key for fallback
GEMINI_API_KEY=your_gemini_key_here        # optional final fallback

GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# Where qualified leads are sent (reuse the contact form's Apps Script / Sheet)
LEAD_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Next-action CTAs surfaced by the bot
WHATSAPP_NUMBER=919956655662
BOOKING_URL=/contact-us/
