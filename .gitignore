.DS_Store
**/.DS_Store
__pycache__/
*.pyc

# secrets — never commit
.env
.env.*
!.env.example

# Scratch images / office lock files accidentally left in the repo root
# (real site imagery lives in site/assets as .webp)
/*.png
/*.jpg
/*.jpeg
.~lock.*#

# Local scratch that is deliberately not part of the repo. The root-level
# /*.png rule below only covers the root, so the folder needs its own rule.
/_local/
